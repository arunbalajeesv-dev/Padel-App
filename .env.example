# Firebase service account credentials
# Copy this file to .env and fill in real values from the service account JSON.
# .env is gitignored; this file is committed, so never put real values here.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
# The `private_key` field from the service account JSON, NOT `private_key_id`.
# Keep the quotes; newlines stay escaped as \n.
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
# Must match the client's VITE_FIREBASE_STORAGE_BUCKET. Only used by profile
# photo upload (photoService.js) — Firebase console > Storage > Files.
FIREBASE_STORAGE_BUCKET=

# Server
PORT=3000
NODE_ENV=development

# Run scheduled jobs inside the API process rather than a separate worker
RUN_CRON_IN_PROCESS=false
