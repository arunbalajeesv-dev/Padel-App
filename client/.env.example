# Copy to client/.env and fill in. Vite only exposes vars prefixed VITE_.
#
# EVERY VALUE HERE IS PUBLIC. It ships inside the JavaScript bundle and is
# readable by anyone who opens devtools. That is fine and by design — the
# Firebase web config identifies the project, it does not grant access. Access
# is enforced by Firebase Auth and Firestore security rules.
#
# NEVER put the Admin SDK service account here (FIREBASE_PRIVATE_KEY,
# FIREBASE_CLIENT_EMAIL). Those live in the BACKEND .env only. That key bypasses
# every security rule in the project; in a browser bundle it is a total compromise.

# --- Express API ------------------------------------------------------------
# Local:    http://localhost:3000
# Deployed: https://chennaipadelranking.onrender.com
VITE_API_BASE_URL=http://localhost:3000

# --- Firebase web config (public) -------------------------------------------
# Firebase console > Project settings > General > Your apps > Web app > SDK setup
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=chennai-padel.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=chennai-padel
VITE_FIREBASE_STORAGE_BUCKET=chennai-padel.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
